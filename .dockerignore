.git
.gitignore

# Project Documentation
specs/
docs/

# IDE files
.vscode/
.idea/

# Backend (C#)
**/bin/
**/obj/
backend/TodoList.Tests/

# Frontend (Node.js)
frontend/node_modules/
frontend/dist/
frontend/coverage/

# Environment and Logs
.env*
*.log
